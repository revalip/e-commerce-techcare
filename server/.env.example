PORT=4000
NODE_ENV=development

# Database MySQL (lokal XAMPP/Laragon atau cloud TiDB/Aiven/Railway)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=techcare

# Keamanan JWT (WAJIB diganti string acak min. 32 karakter saat deploy produksi!)
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter

# Daftar origin frontend yang diizinkan (pisahkan koma jika lebih dari satu)
CLIENT_URL=http://localhost:5173

# Password akun demo untuk script `npm run seed` (opsional, hanya untuk seed lokal/demo)
SEED_ADMIN_PASSWORD=admin123
SEED_BUYER_PASSWORD=buyer123
